# Copy this file to backend/.env and replace placeholders locally.
# Never commit backend/.env or share its values.

GEMINI_API_KEY=your-gemini-api-key

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Recommended for Render: Resend sends over HTTPS, so it works on the free plan.
MAIL_ENABLED=true
MAIL_FROM="AshAI <onboarding@resend.dev>"
RESEND_API_KEY=re_your-resend-api-key

# Optional SMTP fallback for local development or paid hosts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password

# Set a private Base64-encoded key of at least 32 bytes in production.
JWT_SECRET=your-base64-encoded-jwt-secret

# Public URL used inside verification and password-reset emails.
FRONTEND_URL=https://your-frontend.example.com
