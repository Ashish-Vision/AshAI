# Copy this file to backend/.env and replace placeholders locally.
# Never commit backend/.env or share its values.

GEMINI_API_KEY=your-gemini-api-key

# Local AI is the default. Gemini is only used if Ollama cannot answer.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_STANDARD_MODEL=gemma3:4b
OLLAMA_PRO_MODEL=gemma3:4b
OLLAMA_CODE_MODEL=qwen2.5-coder:7b

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Private local workspace: only this email may register or sign in.
PERSONAL_MODE_ENABLED=true
PERSONAL_EMAIL=your-private-email@gmail.com
FRONTEND_URL=http://localhost:5500

# Email verification is unnecessary in personal mode.
MAIL_ENABLED=false

# Optional mail providers for non-personal mode or password-reset emails.
MAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password

# Set a private Base64-encoded key of at least 32 bytes in production.
JWT_SECRET=your-base64-encoded-jwt-secret
