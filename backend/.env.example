# Copy this file to backend/.env and replace placeholders locally.
# Never commit backend/.env or share its values.

GEMINI_API_KEY=your-gemini-api-key

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Gmail SMTP example. Enable 2-Step Verification and create a Google App Password.
MAIL_ENABLED=true
MAIL_FROM=your-address@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password

# Set a private Base64-encoded key of at least 32 bytes in production.
JWT_SECRET=your-base64-encoded-jwt-secret
